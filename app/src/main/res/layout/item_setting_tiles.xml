<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/gutter"
    android:paddingBottom="@dimen/space_3">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tileLeft"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_1"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/portal_surface"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:strokeColor="@color/portal_line"
        app:strokeWidth="1dp">

        <include layout="@layout/item_setting_tile_body" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tileRight"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_1"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/portal_surface"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:strokeColor="@color/portal_line"
        app:strokeWidth="1dp">

        <include layout="@layout/item_setting_tile_body" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
