<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/selectableItemBackground"
    android:minHeight="112dp"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="@dimen/icon_box"
        android:layout_height="@dimen/icon_box"
        android:background="@drawable/bg_icon_box">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/portal_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tileDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
